{
  "id": "breakbeat",
  "name": "Breakbeat",
  "abbrev": "BB",
  "version": "0.4.25",
  "description": "Breakbeat generator with algorithmic retriggering",
  "author": "mestela",
  "license": "MIT",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "label": "Main",
          "params": [
            {
              "key": "A_sample_path",
              "label": "A Sample",
              "type": "filepath",
              "root": "/data/UserData/breakbeat-samples",
              "filter": ".wav",
              "default": "/data/UserData/breakbeat-samples/Built-in/amen.wav"
            },
            {
              "key": "A_sample_length",
              "label": "A Length",
              "type": "enum",
              "options": [
                "1/4 bar",
                "1/2 bar",
                "1 bar",
                "2 bars",
                "4 bars",
                "8 bars"
              ],
              "default": 2
            },
            {
              "key": "B_sample_path",
              "label": "B Sample",
              "type": "filepath",
              "root": "/data/UserData/breakbeat-samples",
              "filter": ".wav",
              "default": "/data/UserData/breakbeat-samples/Built-in/amen09.wav"
            },
            {
              "key": "B_sample_length",
              "label": "B Length",
              "type": "enum",
              "options": [
                "1/4 bar",
                "1/2 bar",
                "1 bar",
                "2 bars",
                "4 bars",
                "8 bars"
              ],
              "default": 2
            },
            {
              "key": "B_chance",
              "label": "B Chance",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "complexity",
              "label": "Complexity",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50
            },
            {
              "key": "phrase",
              "label": "Phrase",
              "type": "enum",
              "options": [
                "Off",
                "2 bars",
                "4 bars",
                "8 bars",
                "16 bars"
              ],
              "default": 0
            },
            {
              "key": "status",
              "label": "Status",
              "type": "enum",
              "options": [
                "-"
              ],
              "default": 0
            },
            {
              "level": "anchors",
              "label": "Anchors"
            },
            {
              "level": "retrig",
              "label": "Retrig"
            },
            {
              "level": "stretch",
              "label": "Stretch"
            }
          ],
          "knobs": [
            "A_sample_path",
            "A_sample_length",
            "B_sample_path",
            "B_sample_length",
            "B_chance",
            "complexity",
            "phrase",
            "status"
          ],
          "name": "Main"
        },
        "anchors": {
          "name": "Anchors",
          "params": [
            {
              "key": "anchor",
              "label": "Anchor",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "roll",
              "label": "Roll",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "fill",
              "label": "Fill",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            }
          ],
          "knobs": [
            "anchor",
            "roll",
            "fill"
          ]
        },
        "retrig": {
          "name": "Retrig",
          "params": [
            {
              "key": "retrig_2x",
              "label": "Retrig 2x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "retrig_3x",
              "label": "Retrig 3x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "retrig_4x",
              "label": "Retrig 4x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "retrig_8x",
              "label": "Retrig 8x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            }
          ],
          "knobs": [
            "retrig_2x",
            "retrig_3x",
            "retrig_4x",
            "retrig_8x"
          ]
        },
        "stretch": {
          "name": "Stretch",
          "params": [
            {
              "key": "stretch_chance",
              "label": "Chance",
              "name": "Chance",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "stretch_length_min",
              "label": "Ln Min",
              "name": "Length Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "stretch_length_max",
              "label": "Ln Max",
              "name": "Length Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "stretch_slice_min",
              "label": "Sl Min",
              "name": "Slice Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "stretch_slice_max",
              "label": "Sl Max",
              "name": "Slice Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "key": "stretch_pitch_min",
              "label": "PtchMin",
              "name": "Pitch Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50
            },
            {
              "key": "stretch_pitch_max",
              "label": "PtchMax",
              "name": "Pitch Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50
            },
            {
              "key": "grain_fx",
              "label": "Grn FX",
              "name": "Grain FX",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0
            },
            {
              "level": "stretch_fx",
              "label": "Stretch FX"
            }
          ],
          "knobs": [
            "stretch_chance",
            "stretch_length_min",
            "stretch_length_max",
            "stretch_slice_min",
            "stretch_slice_max",
            "stretch_pitch_min",
            "stretch_pitch_max",
            "grain_fx"
          ]
        },
        "stretch_fx": {
          "name": "Stretch FX",
          "params": [
            {
              "key": "grain_cycle_ms",
              "label": "GrnCyc",
              "name": "Grain Cycle",
              "type": "int",
              "min": 10,
              "max": 120,
              "default": 40
            },
            {
              "key": "pitch_lock",
              "label": "PiLck",
              "name": "Pitch Lock",
              "type": "enum",
              "options": [
                "Off",
                "On"
              ],
              "default": 0
            }
          ],
          "knobs": [
            "grain_cycle_ms",
            "pitch_lock"
          ]
        }
      }
    }
  },
  "defaults": {
    "preset": 0
  }
}
