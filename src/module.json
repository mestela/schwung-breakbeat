{
  "id": "breakbeat",
  "name": "Breakbeat",
  "abbrev": "BB",
  "version": "0.4.47",
  "description": "Breakbeat generator with algorithmic retriggering",
  "author": "mestela",
  "license": "MIT",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "label": "Main",
          "params": [
            {
              "key": "A_sample_path",
              "label": "Sample A",
              "type": "filepath",
              "root": "/data/UserData/breakbeat-samples",
              "filter": ".wav",
              "default": "/data/UserData/breakbeat-samples/Built-in/amen.wav",
              "short_name": "A Sample"
            },
            {
              "key": "A_sample_length",
              "label": "Sample A Length",
              "type": "enum",
              "options": [
                "1/4 bar",
                "1/2 bar",
                "1 bar",
                "2 bars",
                "4 bars",
                "8 bars"
              ],
              "default": 2,
              "short_name": "A Length"
            },
            {
              "key": "B_sample_path",
              "label": "Sample B",
              "type": "filepath",
              "root": "/data/UserData/breakbeat-samples",
              "filter": ".wav",
              "default": "/data/UserData/breakbeat-samples/Built-in/amen09.wav",
              "short_name": "B Sample"
            },
            {
              "key": "B_sample_length",
              "label": "Sample B Length",
              "type": "enum",
              "options": [
                "1/4 bar",
                "1/2 bar",
                "1 bar",
                "2 bars",
                "4 bars",
                "8 bars"
              ],
              "default": 2,
              "short_name": "B Length"
            },
            {
              "key": "B_chance",
              "label": "Sample B Chance",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "B Chance"
            },
            {
              "key": "complexity",
              "label": "Complexity",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50,
              "short_name": "Cmplx"
            },
            {
              "key": "phrase",
              "label": "Phrase Length",
              "type": "enum",
              "options": [
                "Off",
                "2 bars",
                "4 bars",
                "8 bars",
                "16 bars"
              ],
              "default": 0,
              "short_name": "Phrase"
            },
            {
              "key": "status",
              "label": "Playback Status",
              "type": "canvas",
              "short_name": "Status",
              "canvas_script": "status_view.js",
              "show_value": true,
              "show_footer": false,
              "fullscreen_live_ms": 50,
              "extra_keys": [
                "status_info",
                "wave_a",
                "wave_b"
              ]
            },
            {
              "level": "anchors",
              "label": "Anchors"
            },
            {
              "level": "slicing",
              "label": "Slicing"
            },
            {
              "level": "retrig",
              "label": "Retrig"
            },
            {
              "level": "stretch",
              "label": "Stretch"
            },
            {
              "level": "master",
              "label": "Master"
            },
            {
              "level": "envelope",
              "label": "Envelope"
            }
          ],
          "knobs": [
            "A_sample_path",
            "A_sample_length",
            "B_sample_path",
            "B_sample_length",
            "B_chance",
            "complexity",
            "phrase",
            "status"
          ],
          "name": "Main"
        },
        "anchors": {
          "label": "Anchors",
          "params": [
            {
              "key": "anchor_1",
              "label": "Slice 1 at Position 1",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Slice 1"
            },
            {
              "key": "anchor_2",
              "label": "Slice 2 at Position 2",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Slice 2"
            },
            {
              "key": "anchor_3",
              "label": "Slice 3 at Position 3",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Slice 3"
            },
            {
              "key": "anchor_4",
              "label": "Slice 4 at Position 4",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Slice 4"
            },
            {
              "key": "anchor_5",
              "label": "Slice 5 at Position 5",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Slice 5"
            },
            {
              "key": "anchor_6",
              "label": "Slice 6 at Position 6",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Slice 6"
            },
            {
              "key": "anchor_7",
              "label": "Slice 7 at Position 7",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Slice 7"
            },
            {
              "key": "anchor_8",
              "label": "Slice 8 at Position 8",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Slice 8"
            }
          ],
          "knobs": [
            "anchor_1",
            "anchor_2",
            "anchor_3",
            "anchor_4",
            "anchor_5",
            "anchor_6",
            "anchor_7",
            "anchor_8"
          ]
        },
        "slicing": {
          "label": "Slicing",
          "params": [
            {
              "key": "mode_a",
              "label": "Break A Mode",
              "type": "enum",
              "options": [
                "Grid",
                "Manual"
              ],
              "default": 0,
              "short_name": "A Mode"
            },
            {
              "key": "edit_a",
              "label": "Edit Break A",
              "type": "canvas",
              "short_name": "Edit A",
              "canvas_script": "slice_editor.js",
              "show_value": false,
              "show_footer": false,
              "fullscreen_live_ms": 100,
              "extra_keys": [
                "edit_a",
                "wave_a"
              ]
            },
            {
              "key": "mode_b",
              "label": "Break B Mode",
              "type": "enum",
              "options": [
                "Grid",
                "Manual"
              ],
              "default": 0,
              "short_name": "B Mode"
            },
            {
              "key": "edit_b",
              "label": "Edit Break B",
              "type": "canvas",
              "short_name": "Edit B",
              "canvas_script": "slice_editor.js",
              "show_value": false,
              "show_footer": false,
              "fullscreen_live_ms": 100,
              "extra_keys": [
                "edit_b",
                "wave_b"
              ]
            },
            {
              "key": "early_end",
              "label": "Early End",
              "type": "enum",
              "options": [
                "Silence",
                "Reverse"
              ],
              "default": 0,
              "short_name": "Early End"
            }
          ],
          "knobs": [
            "mode_a",
            "edit_a",
            "mode_b",
            "edit_b",
            "early_end"
          ]
        },
        "retrig": {
          "name": "Retrig",
          "params": [
            {
              "key": "retrig_2x",
              "label": "Retrigger 2x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Retrig 2x"
            },
            {
              "key": "retrig_push",
              "label": "Push 2x (first two 4x hits)",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Push 2x"
            },
            {
              "key": "retrig_drag",
              "label": "Drag 2x (dotted 16th repeat)",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Drag 2x"
            },
            {
              "key": "retrig_3x",
              "label": "Retrigger 3x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Retrig 3x"
            },
            {
              "key": "retrig_4x",
              "label": "Retrigger 4x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Retrig 4x"
            },
            {
              "key": "retrig_8x",
              "label": "Retrigger 8x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Retrig 8x"
            },
            {
              "key": "retrig_16x",
              "label": "Retrigger 16x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "R16x"
            },
            {
              "key": "retrig_32x",
              "label": "Retrigger 32x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "R32x"
            }
          ],
          "knobs": [
            "retrig_2x",
            "retrig_push",
            "retrig_drag",
            "retrig_3x",
            "retrig_4x",
            "retrig_8x",
            "retrig_16x",
            "retrig_32x"
          ]
        },
        "stretch": {
          "name": "Stretch",
          "params": [
            {
              "key": "stretch_chance",
              "label": "Stretch Chance",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Chance"
            },
            {
              "key": "stretch_length_min",
              "label": "Length Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Ln Min"
            },
            {
              "key": "stretch_length_max",
              "label": "Length Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Ln Max"
            },
            {
              "key": "stretch_slice_min",
              "label": "Slice Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Sl Min"
            },
            {
              "key": "stretch_slice_max",
              "label": "Slice Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Sl Max"
            },
            {
              "key": "stretch_pitch_min",
              "label": "Pitch Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50,
              "short_name": "PtchMin"
            },
            {
              "key": "stretch_pitch_max",
              "label": "Pitch Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50,
              "short_name": "PtchMax"
            }
          ],
          "knobs": [
            "stretch_chance",
            "stretch_length_min",
            "stretch_length_max",
            "stretch_slice_min",
            "stretch_slice_max",
            "stretch_pitch_min",
            "stretch_pitch_max"
          ]
        },
        "master": {
          "name": "Master",
          "params": [
            {
              "key": "grain_cycle_ms",
              "label": "Grain Cycle",
              "type": "int",
              "min": 10,
              "max": 120,
              "default": 40,
              "short_name": "GrnCyc"
            },
            {
              "key": "grain_fx",
              "label": "Grain Effect",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Grn FX"
            },
            {
              "key": "A_vol",
              "label": "Sample A Volume",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 100,
              "short_name": "A Vol"
            },
            {
              "key": "B_vol",
              "label": "Sample B Volume",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 100,
              "short_name": "B Vol"
            },
            {
              "key": "quant",
              "label": "Note Quantization",
              "type": "enum",
              "options": [
                "8ths",
                "16ths"
              ],
              "default": 0,
              "short_name": "Quant"
            }
          ],
          "knobs": [
            "grain_fx",
            "grain_cycle_ms",
            "A_vol",
            "B_vol",
            "quant"
          ]
        },
        "envelope": {
          "label": "Envelope",
          "params": [
            {
              "key": "attack_ms",
              "label": "Attack",
              "type": "int",
              "min": 0,
              "max": 250,
              "default": 0,
              "unit": "ms",
              "short_name": "Attack"
            },
            {
              "key": "decay_ms",
              "label": "Decay",
              "type": "int",
              "min": 0,
              "max": 250,
              "default": 0,
              "unit": "ms",
              "short_name": "Decay"
            }
          ],
          "knobs": [
            "attack_ms",
            "decay_ms"
          ]
        }
      }
    }
  },
  "defaults": {
    "preset": 0
  }
}
