{
  "id": "breakbeat",
  "name": "Breakbeat",
  "abbrev": "BB",
  "version": "0.4.27",
  "description": "Breakbeat generator with algorithmic retriggering",
  "author": "mestela",
  "license": "MIT",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "label": "Main",
          "params": [
            {
              "key": "A_sample_path",
              "label": "Sample A",
              "type": "filepath",
              "root": "/data/UserData/breakbeat-samples",
              "filter": ".wav",
              "default": "/data/UserData/breakbeat-samples/Built-in/amen.wav",
              "short_name": "A Sample"
            },
            {
              "key": "A_sample_length",
              "label": "Sample A Length",
              "type": "enum",
              "options": [
                "1/4 bar",
                "1/2 bar",
                "1 bar",
                "2 bars",
                "4 bars",
                "8 bars"
              ],
              "default": 2,
              "short_name": "A Length"
            },
            {
              "key": "B_sample_path",
              "label": "Sample B",
              "type": "filepath",
              "root": "/data/UserData/breakbeat-samples",
              "filter": ".wav",
              "default": "/data/UserData/breakbeat-samples/Built-in/amen09.wav",
              "short_name": "B Sample"
            },
            {
              "key": "B_sample_length",
              "label": "Sample B Length",
              "type": "enum",
              "options": [
                "1/4 bar",
                "1/2 bar",
                "1 bar",
                "2 bars",
                "4 bars",
                "8 bars"
              ],
              "default": 2,
              "short_name": "B Length"
            },
            {
              "key": "B_chance",
              "label": "Sample B Chance",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "B Chance"
            },
            {
              "key": "complexity",
              "label": "Complexity",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50
            },
            {
              "key": "phrase",
              "label": "Phrase Length",
              "type": "enum",
              "options": [
                "Off",
                "2 bars",
                "4 bars",
                "8 bars",
                "16 bars"
              ],
              "default": 0,
              "short_name": "Phrase"
            },
            {
              "key": "status",
              "label": "Playback Status",
              "type": "enum",
              "options": [
                "-"
              ],
              "default": 0,
              "short_name": "Status",
              "access": "read"
            },
            {
              "level": "anchors",
              "label": "Anchors"
            },
            {
              "level": "retrig",
              "label": "Retrig"
            },
            {
              "level": "stretch",
              "label": "Stretch"
            }
          ],
          "knobs": [
            "A_sample_path",
            "A_sample_length",
            "B_sample_path",
            "B_sample_length",
            "B_chance",
            "complexity",
            "phrase",
            "status"
          ],
          "name": "Main"
        },
        "anchors": {
          "name": "Anchors",
          "params": [
            {
              "key": "anchor",
              "label": "Anchor Strength",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Anchor"
            },
            {
              "key": "roll",
              "label": "Roll Amount",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Roll"
            },
            {
              "key": "fill",
              "label": "Fill Amount",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Fill"
            }
          ],
          "knobs": [
            "anchor",
            "roll",
            "fill"
          ]
        },
        "retrig": {
          "name": "Retrig",
          "params": [
            {
              "key": "retrig_2x",
              "label": "Retrigger 2x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Retrig 2x"
            },
            {
              "key": "retrig_3x",
              "label": "Retrigger 3x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Retrig 3x"
            },
            {
              "key": "retrig_4x",
              "label": "Retrigger 4x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Retrig 4x"
            },
            {
              "key": "retrig_8x",
              "label": "Retrigger 8x",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Retrig 8x"
            }
          ],
          "knobs": [
            "retrig_2x",
            "retrig_3x",
            "retrig_4x",
            "retrig_8x"
          ]
        },
        "stretch": {
          "name": "Stretch",
          "params": [
            {
              "key": "stretch_chance",
              "label": "Stretch Chance",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Chance"
            },
            {
              "key": "stretch_length_min",
              "label": "Length Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Ln Min"
            },
            {
              "key": "stretch_length_max",
              "label": "Length Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Ln Max"
            },
            {
              "key": "stretch_slice_min",
              "label": "Slice Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Sl Min"
            },
            {
              "key": "stretch_slice_max",
              "label": "Slice Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Sl Max"
            },
            {
              "key": "stretch_pitch_min",
              "label": "Pitch Minimum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50,
              "short_name": "PtchMin"
            },
            {
              "key": "stretch_pitch_max",
              "label": "Pitch Maximum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 50,
              "short_name": "PtchMax"
            },
            {
              "key": "grain_fx",
              "label": "Grain Effect",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "short_name": "Grn FX"
            },
            {
              "level": "stretch_fx",
              "label": "Stretch FX"
            }
          ],
          "knobs": [
            "stretch_chance",
            "stretch_length_min",
            "stretch_length_max",
            "stretch_slice_min",
            "stretch_slice_max",
            "stretch_pitch_min",
            "stretch_pitch_max",
            "grain_fx"
          ]
        },
        "stretch_fx": {
          "name": "Stretch FX",
          "params": [
            {
              "key": "grain_cycle_ms",
              "label": "Grain Cycle",
              "type": "int",
              "min": 10,
              "max": 120,
              "default": 40,
              "short_name": "GrnCyc"
            },
            {
              "key": "pitch_lock",
              "label": "Pitch Lock",
              "type": "enum",
              "options": [
                "Off",
                "On"
              ],
              "default": 0,
              "short_name": "PiLck"
            }
          ],
          "knobs": [
            "grain_cycle_ms",
            "pitch_lock"
          ]
        }
      }
    }
  },
  "defaults": {
    "preset": 0
  }
}
